# Lets you use the whole pad in ds4-tester without sudo, and puts your
# lightbar colour back on connect. Install steps are in the README.

# Put back the lightbar colour picked in ds4-tester. It's a user service so it
# can read your config. Does nothing if install-user.sh hasn't been run.
ACTION=="add", SUBSYSTEM=="hidraw", DRIVERS=="playstation", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="ds4-lightbar@%k.service"

# Let the logged-in user read the touchpad. Fedora already does this for the
# gamepad part but misses the touchpad. Has to come before 73-seat-late.rules.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="054c", ATTRS{name}=="*Touchpad", TAG+="uaccess"

# Let anyone set the lightbar colour. These files can't be given to just one
# user, and the worst anyone can do is change a pad's colour.
SUBSYSTEM=="leds", KERNEL=="input*:red|input*:green|input*:blue", DRIVERS=="playstation", RUN+="/usr/bin/chmod 0666 /sys%p/brightness"
